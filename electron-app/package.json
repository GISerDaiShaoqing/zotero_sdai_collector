{
  "name": "zotero-sdai-collector",
  "productName": "zotero_sdai_collector",
  "description": "剪贴板/飞书捕获微信推送与论文直链，LLM 分类后写入 Zotero",
  "author": {
    "name": "Shaoqing Dai",
    "email": "shaoqing.dai@outlook.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/GISerDaiShaoqing/zotero_sdai_collector.git"
  },
  "version": "1.2.2",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "build": {
    "appId": "com.zoterocollector.app",
    "productName": "zotero_sdai_collector",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "hud.html",
      "hud.css",
      "hud.js",
      "renderer/**",
      "src/**",
      "seed/**",
      "assets/**"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "assets/icon.png"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "assets/icon.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/icon.png",
      "category": "Science",
      "maintainer": "Shaoqing Dai <shaoqing.dai@outlook.com>"
    }
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.76.0"
  }
}
